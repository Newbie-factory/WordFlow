<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <PropertyGroup>
    <WordFlowApplicationIcon Condition="'$(WordFlowApplicationIcon)' == ''">Assets\Icons\wordflow-classic.ico</WordFlowApplicationIcon>
    <ApplicationIcon>$(WordFlowApplicationIcon)</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WordFlow.Application\WordFlow.Application.csproj" />
    <ProjectReference Include="..\WordFlow.Infrastructure\WordFlow.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\data\ielts\vocabulary.sqlite3" Link="Data\ielts\vocabulary.sqlite3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\data\ielts\relations.sqlite3" Link="Data\ielts\relations.sqlite3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\data\ielts\manifest.json" Link="Data\ielts\manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\data\ielts\relations-manifest.json" Link="Data\ielts\relations-manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WordFlow.App.Tests" />
  </ItemGroup>
  <Target Name="CreateDesktopShortcut" AfterTargets="Build">
    <PropertyGroup>
      <DesktopLnk>$([System.Environment]::GetFolderPath(SpecialFolder.DesktopDirectory))\WordFlow.lnk</DesktopLnk>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; { $ws = New-Object -ComObject WScript.Shell; $sc = $ws.CreateShortcut('$(DesktopLnk)'); $sc.TargetPath = '$(TargetDir)\WordFlow.App.exe'; $sc.WorkingDirectory = '$(TargetDir)'; $sc.Save() }&quot;" />
  </Target>
</Project>
