<UserControl x:Class="WordFlow.App.Views.Controls.RelationDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="420" d:DesignWidth="440"
             mc:Ignorable="d"
             Focusable="False">
    <Grid Margin="20,0,20,20">
        <Border Background="{StaticResource Brush.Canvas}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="176" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource Type.Title}" FontWeight="SemiBold" />
                        <TextBlock Text="完整离线结果 · 最多显示五项后滚动" Margin="0,2,0,0"
                                   FontSize="{StaticResource Type.Caption}" Foreground="{StaticResource Brush.InkMuted}" />
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="RelationSearchBox" Style="{StaticResource TextBox.Search}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="搜索关系词" TabIndex="20" />
                        <TextBlock Text="搜索全部结果" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   FontSize="12" Foreground="{StaticResource Brush.InkMuted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <ListBox x:Name="RelationResults" Grid.Row="1" ItemsSource="{Binding FilteredItems}"
                         Background="Transparent" BorderThickness="0" MaxHeight="420"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyboardNavigation.TabNavigation="Continue"
                         AutomationProperties.Name="关系词完整结果">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="8" Padding="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Background="{StaticResource Brush.AccentSurface}"
                                                    CornerRadius="{StaticResource Radius.Badge}" Padding="7,3">
                                                <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{StaticResource Brush.AccentStrong}" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Word}" FontFamily="{StaticResource Font.Display}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Phonetic}" Margin="8,2,0,0" FontSize="11" Foreground="{StaticResource Brush.InkMuted}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Chinese}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Contrast}" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource Brush.InkMuted}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Collocation, StringFormat=搭配 · {0}}" Margin="0,2,0,0" FontSize="11"
                                                   Foreground="{StaticResource Brush.InkMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Button.Base}" Width="32" Height="32" MinHeight="32" Padding="7"
                                                IsEnabled="{Binding CanUseWordActions}" Click="Speak_Click"
                                                ToolTip="播放离线发音" AutomationProperties.Name="播放离线发音" TabIndex="21">
                                            <Viewbox Width="15" Height="15">
                                                <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                      Data="M3,8 L7,8 L12,4 L12,20 L7,16 L3,16 Z M15,8 C17,10 17,14 15,16 M18,5 C22,9 22,15 18,19"
                                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" />
                                            </Viewbox>
                                        </Button>
                                        <Button Style="{StaticResource Button.Base}" Width="32" Height="32" MinHeight="32" Margin="0,4,0,0" Padding="7"
                                                IsEnabled="{Binding CanUseWordActions}" Click="Details_Click"
                                                ToolTip="打开完整词条" AutomationProperties.Name="打开完整词条" TabIndex="22">
                                            <Viewbox Width="15" Height="15">
                                                <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.8"
                                                      Data="M4,3 L17,3 L21,7 L21,21 L4,21 Z M17,3 L17,7 L21,7 M8,11 L17,11 M8,15 L17,15" />
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="播放离线发音" IsEnabled="{Binding CanUseWordActions}" Click="Speak_Click" />
                                        <MenuItem Header="打开完整词条" IsEnabled="{Binding CanUseWordActions}" Click="Details_Click" />
                                        <Separator />
                                        <MenuItem Header="加入学习" IsEnabled="{Binding CanUseWordActions}" Click="AddToLearning_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="{Binding EmptyMessage}" HorizontalAlignment="Center" Padding="8"
                               Foreground="{StaticResource Brush.InkMuted}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
