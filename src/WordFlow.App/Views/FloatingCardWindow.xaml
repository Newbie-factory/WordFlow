<Window x:Class="WordFlow.App.Views.FloatingCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WordFlow.App.Views.Controls"
        Title="WordFlow 学习卡" Width="480" MinHeight="326" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        AutomationProperties.Name="WordFlow 悬浮学习卡">
    <Grid>
    <Border x:Name="WindowSurface" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.ControlBorder}"
            BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Effect="{StaticResource Shadow.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="StableWordBlock" Grid.Row="0" Height="270">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="DragRegion" Grid.Row="0" Background="Transparent" Cursor="SizeAll"
                        MouseLeftButtonDown="DragRegion_MouseLeftButtonDown"
                        AutomationProperties.Name="拖动悬浮卡区域">
                    <Grid Margin="20,0">
                        <TextBlock Text="WORDFLOW" VerticalAlignment="Center" FontFamily="{StaticResource Font.Display}"
                                   FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.InkMuted}" />
                        <Rectangle Width="28" Height="3" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Fill="{StaticResource Brush.Border}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="24,3,24,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="WordText" Command="{Binding SpeakCurrentWordCommand}" HorizontalAlignment="Left" Padding="0"
                            Background="Transparent" BorderThickness="0" FocusVisualStyle="{StaticResource Focus.Ring}" TabIndex="0"
                            AutomationProperties.Name="{Binding Word, StringFormat=播放当前单词 {0} 离线发音}"
                            AutomationProperties.HelpText="{Binding Word}">
                        <TextBlock Text="{Binding Word}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Type.Word}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Button x:Name="CurrentDetailsButton" Command="{Binding OpenCurrentDetailsCommand}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Style="{StaticResource Button.Base}" MinHeight="28" Padding="9,4" TabIndex="1"
                            AutomationProperties.Name="{Binding Word, StringFormat=打开当前单词 {0} 完整词条}">词条</Button>
                    <TextBlock x:Name="PhoneticText" Grid.Row="1" Text="{Binding Phonetic}" Margin="1,2,0,0"
                               FontSize="15" Foreground="{StaticResource Brush.AccentStrong}"
                               AutomationProperties.Name="{Binding Phonetic, StringFormat=当前单词音标 {0}}"
                               AutomationProperties.HelpText="{Binding Phonetic}" />
                    <TextBlock x:Name="ChineseText" Grid.Row="2" Text="{Binding Chinese}" Margin="1,10,0,0"
                               FontSize="16" FontWeight="Medium" TextWrapping="Wrap" MaxHeight="46"
                               AutomationProperties.Name="{Binding Chinese, StringFormat=当前单词中文释义 {0}}"
                               AutomationProperties.HelpText="{Binding Chinese}" />
                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                        <DockPanel Margin="0,14,0,8">
                            <TextBlock Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource Type.Caption}"
                                       Foreground="{StaticResource Brush.InkMuted}" />
                            <Button x:Name="UndoButton" DockPanel.Dock="Right" Style="{StaticResource Button.Base}"
                                    Command="{Binding UndoCommand}" Padding="9,4" MinHeight="28" TabIndex="8"
                                    AutomationProperties.Name="撤销上一学习操作">
                                <TextBlock><Run Text="撤销 "/><Run Text="{Binding UndoGesture, Mode=OneWay}" /></TextBlock>
                            </Button>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AgainButton" Grid.Column="0" Style="{StaticResource Button.Base}" Command="{Binding AgainCommand}"
                                    TabIndex="2" AutomationProperties.Name="不认识，提交评分">
                                <StackPanel><TextBlock Text="不认识" HorizontalAlignment="Center" /><TextBlock Text="{Binding AgainGesture}" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource Brush.InkMuted}" /></StackPanel>
                            </Button>
                            <Button x:Name="HardButton" Grid.Column="2" Style="{StaticResource Button.Base}" Command="{Binding HardCommand}"
                                    TabIndex="3" AutomationProperties.Name="模糊，提交评分">
                                <StackPanel><TextBlock Text="模糊" HorizontalAlignment="Center" /><TextBlock Text="{Binding HardGesture}" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource Brush.InkMuted}" /></StackPanel>
                            </Button>
                            <Button x:Name="GoodButton" Grid.Column="4" Style="{StaticResource Button.Primary}" Command="{Binding GoodCommand}"
                                    TabIndex="4" AutomationProperties.Name="认识，提交评分">
                                <StackPanel><TextBlock Text="认识" HorizontalAlignment="Center" Foreground="White" /><TextBlock Text="{Binding GoodGesture}" HorizontalAlignment="Center" FontSize="10" Foreground="White" Opacity="0.86" /></StackPanel>
                            </Button>
                            <Button x:Name="SlashButton" Grid.Column="6" Style="{StaticResource Button.Base}" Command="{Binding SlashCommand}"
                                    TabIndex="5" AutomationProperties.Name="斩词并移出学习队列">
                                <StackPanel><TextBlock Text="斩" HorizontalAlignment="Center" /><TextBlock Text="{Binding SlashGesture}" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource Brush.InkMuted}" /></StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="20,0,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SynonymsButton" Grid.Column="0" Style="{StaticResource Button.Base}"
                        Command="{Binding ToggleSynonymsCommand}" TabIndex="6" AutomationProperties.Name="展开或收起近义辨析">
                    <DockPanel><TextBlock Text="近义辨析" /><TextBlock Text="{Binding SynonymsGesture}" Margin="8,0,0,0" Foreground="{StaticResource Brush.InkMuted}" /></DockPanel>
                </Button>
                <Button x:Name="ConfusablesButton" Grid.Column="2" Style="{StaticResource Button.Base}"
                        Command="{Binding ToggleConfusablesCommand}" TabIndex="7" AutomationProperties.Name="展开或收起形近易混">
                    <DockPanel><TextBlock Text="形近易混" /><TextBlock Text="{Binding ConfusablesGesture}" Margin="8,0,0,0" Foreground="{StaticResource Brush.InkMuted}" /></DockPanel>
                </Button>
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Margin="20,0,20,12" Padding="10,8" Background="{StaticResource Brush.ErrorSurface}"
                        CornerRadius="{StaticResource Radius.Control}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
                    <TextBlock x:Name="ErrorStatus" Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Error}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                </Border>
                <TextBlock x:Name="AccessibleStatus" Text="{Binding AccessibleStatus}" Height="1" Opacity="0"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Grid>
    </Border>
    <Popup x:Name="SynonymsPopup" PlacementTarget="{Binding ElementName=WindowSurface}" Placement="Bottom" StaysOpen="True"
           AllowsTransparency="True" IsOpen="{Binding Synonyms.IsOpen, Mode=OneWay}" PopupAnimation="None">
        <controls:RelationDrawer x:Name="SynonymsDrawer" DataContext="{Binding Synonyms}" />
    </Popup>
    <Popup x:Name="ConfusablesPopup" PlacementTarget="{Binding ElementName=WindowSurface}" Placement="Bottom" StaysOpen="True"
           AllowsTransparency="True" IsOpen="{Binding Confusables.IsOpen, Mode=OneWay}" PopupAnimation="None">
        <controls:RelationDrawer x:Name="ConfusablesDrawer" DataContext="{Binding Confusables}" />
    </Popup>
    </Grid>
</Window>
