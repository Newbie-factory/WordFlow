<Window x:Class="WordFlow.App.Views.ControlCenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WordFlow 控制中心" Width="760" Height="620" MinWidth="680" MinHeight="500" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Background="{StaticResource Brush.Canvas}" AutomationProperties.Name="WordFlow 控制中心">
 <Border Margin="18" Padding="22" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Effect="{StaticResource Shadow.Card}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource Button.Base}" Click="Close_Click"/><StackPanel><TextBlock Text="控制中心" FontSize="{StaticResource Type.Title}" FontWeight="SemiBold"/><TextBlock Text="学习、快捷键、发音与外观的统一设置" Foreground="{StaticResource Brush.InkMuted}" Margin="0,4,0,0"/></StackPanel></DockPanel>
   <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
    <TabItem Header="今日学习"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,14,4,8"><Border Padding="18" Background="{StaticResource Brush.AccentSurface}" CornerRadius="{StaticResource Radius.Control}"><StackPanel><TextBlock Text="今日进度" FontWeight="SemiBold"/><TextBlock Text="{Binding ReviewedToday, StringFormat=已学习 {0} 个词}" FontSize="24" Margin="0,8,0,0"/><TextBlock Text="{Binding DailyTarget, StringFormat=每日目标 {0} 个}" Foreground="{StaticResource Brush.InkMuted}"/><TextBlock Text="{Binding RemainingToday, StringFormat=剩余 {0} 个}" Foreground="{StaticResource Brush.InkMuted}"/><TextBlock Text="{Binding SlashedTotal, StringFormat=累计已斩 {0} 个}" Foreground="{StaticResource Brush.InkMuted}"/></StackPanel></Border><TextBlock Text="每日学习量" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="新词目标"/><TextBox Text="{Binding DailyPlan.NewLimit, UpdateSourceTrigger=LostFocus}" Margin="0,5,14,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="复习目标"/><TextBox Text="{Binding DailyPlan.SoftReviewLimit, UpdateSourceTrigger=LostFocus}" Margin="0,5,14,0"/></StackPanel><Button Grid.Column="2" Content="保存每日目标" Style="{StaticResource Button.Primary}" Click="SaveDaily_Click" VerticalAlignment="Bottom"/></Grid><TextBlock x:Name="DailyStatus" Foreground="{StaticResource Brush.InkMuted}" Margin="0,8,0,0"/><Button Content="刷新今日进度" Style="{StaticResource Button.Base}" Click="RefreshProgress_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="快捷键"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,14,4,8"><TextBlock Text="全局与卡片快捷键" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="修改后立即持久化并应用；冲突会保留原映射。" Foreground="{StaticResource Brush.InkMuted}" Margin="0,5,0,12"/><ItemsControl ItemsSource="{Binding Shortcuts.Items}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Action}" VerticalAlignment="Center"/><TextBox Text="{Binding ChordDisplay}" Tag="{Binding}" PreviewKeyDown="Shortcut_PreviewKeyDown" Grid.Column="1"/><CheckBox IsChecked="{Binding IsEnabled}" Content="启用" Grid.Column="2" VerticalAlignment="Center"/><Button Content="恢复默认" Click="RestoreShortcut_Click" Tag="{Binding}" Grid.Column="3" Style="{StaticResource Button.Base}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Ctrl+Z 撤销；F4 近义辨析；F5 形近易混；发音快捷键默认未分配。" Foreground="{StaticResource Brush.InkMuted}" Margin="0,14,0,0"/></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="发音"><StackPanel Margin="4,14,4,8"><TextBlock Text="离线发音" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Pronunciation.Availability.Message}" Foreground="{StaticResource Brush.InkMuted}" TextWrapping="Wrap" Margin="0,5,0,16"/><CheckBox Content="切换单词后自动朗读" IsChecked="{Binding Pronunciation.Autoplay}"/><TextBlock Text="音量" Margin="0,16,0,3"/><Slider Minimum="0" Maximum="100" Value="{Binding Pronunciation.Volume}"/><TextBlock Text="语速" Margin="0,12,0,3"/><Slider Minimum="-10" Maximum="10" Value="{Binding Pronunciation.Rate}"/><Button Content="保存发音设置" Click="SavePronunciation_Click" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock Text="{Binding Pronunciation.SettingsIssue}" Foreground="{StaticResource Brush.InkMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></TabItem>
    <TabItem Header="外观"><StackPanel Margin="4,14,4,8"><TextBlock Text="PNG 换肤" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Theme.DisplayName}" Foreground="{StaticResource Brush.InkMuted}" Margin="0,5,0,14"/><StackPanel Orientation="Horizontal"><Button Content="选择 PNG" Style="{StaticResource Button.Base}" Click="Import_Click"/><Button Content="恢复默认" Style="{StaticResource Button.Base}" Margin="10,0,0,0" Click="Reset_Click"/></StackPanel><TextBlock Text="卡片透明度" Margin="0,20,0,4"/><Slider x:Name="OpacitySlider" Minimum="0.15" Maximum="1" TickFrequency="0.05" Value="{Binding Theme.Opacity, UpdateSourceTrigger=PropertyChanged}"/><TextBlock x:Name="ThemeStatus" Foreground="{StaticResource Brush.InkMuted}" Margin="0,8,0,0"/></StackPanel></TabItem>
    <TabItem Header="数据与离线"><StackPanel Margin="4,14,4,8"><TextBlock Text="本地数据" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding OfflineStatus}" Margin="0,10,0,0"/><TextBlock Text="词库：本机 IELTS 词汇与关系数据" Margin="0,8,0,0"/><TextBlock Text="版本：{Binding Version}" Foreground="{StaticResource Brush.InkMuted}" Margin="0,8,0,0"/><TextBlock Text="学习记录、快捷键、发音与换肤设置均保存在本机，不需要网络。" Foreground="{StaticResource Brush.InkMuted}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></TabItem>
   </TabControl><TextBlock Grid.Row="2" Text="完全离线运行 · WordFlow" Foreground="{StaticResource Brush.InkMuted}" Margin="0,16,0,0"/>
  </Grid>
 </Border>
</Window>
