<Window x:Class="WordFlow.App.Views.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordFlow 控制中心" Width="1120" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Background="{StaticResource Brush.Canvas}"
        AutomationProperties.Name="WordFlow 控制中心">
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.InkMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.AccentSurface}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.AccentSurface}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.AccentStrong}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.AccentStrong}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.InkMuted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>

    <Border Margin="16" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Effect="{StaticResource Shadow.Card}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#F8FAFC">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="24,26,18,20">
                    <TextBlock Text="WordFlow" FontFamily="{StaticResource Font.Display}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="离线学习控制中心" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="12,0">
                    <RadioButton Style="{StaticResource NavItem}" IsChecked="True" Tag="Dashboard" Checked="Navigation_Click" AutomationProperties.Name="今日学习"><StackPanel Orientation="Horizontal"><TextBlock Text="01" Width="34" Opacity="0.55"/><TextBlock Text="今日学习"/></StackPanel></RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="Vocabulary" Checked="Navigation_Click" AutomationProperties.Name="词汇库"><StackPanel Orientation="Horizontal"><TextBlock Text="02" Width="34" Opacity="0.55"/><TextBlock Text="词汇库"/></StackPanel></RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="Confusables" Checked="Navigation_Click" AutomationProperties.Name="易混词"><StackPanel Orientation="Horizontal"><TextBlock Text="03" Width="34" Opacity="0.55"/><TextBlock Text="易混词"/></StackPanel></RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="Slashed" Checked="Navigation_Click" AutomationProperties.Name="已斩词汇"><StackPanel Orientation="Horizontal"><TextBlock Text="04" Width="34" Opacity="0.55"/><TextBlock Text="已斩词汇"/></StackPanel></RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="Statistics" Checked="Navigation_Click" AutomationProperties.Name="学习统计"><StackPanel Orientation="Horizontal"><TextBlock Text="05" Width="34" Opacity="0.55"/><TextBlock Text="学习统计"/></StackPanel></RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="Settings" Checked="Navigation_Click" AutomationProperties.Name="设置"><StackPanel Orientation="Horizontal"><TextBlock Text="06" Width="34" Opacity="0.55"/><TextBlock Text="设置"/></StackPanel></RadioButton>
                </StackPanel>
                <Border Grid.Row="2" Margin="18,12,18,20" Padding="12" Background="#EAF3F8" CornerRadius="10">
                    <StackPanel><TextBlock Text="本机模式" FontWeight="SemiBold" Foreground="{StaticResource Brush.AccentStrong}"/><TextBlock Text="无账号 · 无云端 · 无遥测" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                </Border>
            </Grid>
            <Border Grid.Column="1" Background="{StaticResource Brush.Border}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="30,18,26,10">
                    <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource Button.Base}" Click="Close_Click" AutomationProperties.Name="关闭控制中心"/>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="今日学习" FontFamily="{StaticResource Font.Display}" FontSize="25" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageSubtitle" Text="今天学多少、复习多少、进展如何" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="30,6,26,26">
                    <!-- 今日学习 -->
                    <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="今日已学习" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ReviewedToday}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="个词" Style="{StaticResource Muted}"/></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="今日目标" Style="{StaticResource Muted}"/><TextBlock Text="{Binding DailyTarget}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="新词 + 复习" Style="{StaticResource Muted}"/></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="预计剩余" Style="{StaticResource Muted}"/><TextBlock Text="{Binding EstimatedMinutes}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="分钟" Style="{StaticResource Muted}"/></StackPanel></Border>
                                <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="累计已斩" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SlashedTotal}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="可随时恢复" Style="{StaticResource Muted}"/></StackPanel></Border>
                            </Grid>
                            <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="今日进度" Style="{StaticResource SectionTitle}"/><ProgressBar Height="10" Maximum="1" Value="{Binding ProgressRatio, Mode=OneWay}" Foreground="{StaticResource Brush.Accent}" Background="#E4EAF0"/><DockPanel Margin="0,12,0,0"><TextBlock Text="{Binding RemainingToday, StringFormat=还剩 {0} 个}" Style="{StaticResource Muted}"/><Button DockPanel.Dock="Right" Content="刷新进度" Style="{StaticResource Button.Base}" Click="RefreshProgress_Click"/></DockPanel></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="需要关注" Style="{StaticResource SectionTitle}"/><TextBlock Text="困难词会根据连续遗忘与保护状态自动进入优先队列。" Style="{StaticResource Muted}"/><TextBlock Text="不会用焦虑式红色催促，也不会无限增加出现频率。" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
                            </Grid>
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="最近七天" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding SevenDayTrend}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="4" Padding="10" Background="#F6F8FA" CornerRadius="8"><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding Reviewed}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding Day}" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 词汇库 -->
                    <Grid x:Name="VocabularyPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel><Button DockPanel.Dock="Right" Content="搜索本地词库" Style="{StaticResource Button.Primary}" Click="VocabularySearch_Click"/><TextBox Text="{Binding VocabularyQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Search}" Margin="0,0,12,0" AutomationProperties.Name="搜索词汇"/></DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding VocabularyResults}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,10" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource Brush.Border}">
                            <DataGrid.Columns><DataGridTextColumn Header="单词" Binding="{Binding Lemma}" Width="1.2*"/><DataGridTextColumn Header="音标" Binding="{Binding Phonetic}" Width="1.1*"/><DataGridTextColumn Header="简体中文释义" Binding="{Binding Chinese}" Width="2.5*"/><DataGridTextColumn Header="词性" Binding="{Binding PrimaryPartOfSpeech}" Width="*"/></DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="{Binding LibraryStatus}" Style="{StaticResource Muted}"/>
                    </Grid>

                    <!-- 易混词 -->
                    <Grid x:Name="ConfusablesPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel><Button DockPanel.Dock="Right" Content="查找易混关系" Style="{StaticResource Button.Primary}" Click="ConfusableSearch_Click"/><TextBox Text="{Binding ConfusableQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Search}" Margin="0,0,12,0" AutomationProperties.Name="搜索易混词"/></DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ConfusableResults}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,10" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource Brush.Border}">
                            <DataGrid.Columns><DataGridTextColumn Header="词汇" Binding="{Binding Spelling}" Width="1.2*"/><DataGridTextColumn Header="关系类型" Binding="{Binding RelationType}" Width="*"/><DataGridTextColumn Header="音标" Binding="{Binding Phonetic}" Width="*"/><DataGridTextColumn Header="具体释义" Binding="{Binding Chinese}" Width="1.8*"/><DataGridTextColumn Header="关键差异" Binding="{Binding Contrast}" Width="2*"/></DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="{Binding ConfusableStatus}" Style="{StaticResource Muted}"/>
                    </Grid>

                    <!-- 已斩词汇 -->
                    <Grid x:Name="SlashedPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel><Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource Button.Base}" Click="LoadSlashed_Click"/><TextBlock Text="已斩词不会进入自动学习队列；取消斩会保留完整历史与 FSRS 状态。" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SlashedWords}" SelectedItem="{Binding SelectedSlashedWord}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,10" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource Brush.Border}">
                            <DataGrid.Columns><DataGridTextColumn Header="单词" Binding="{Binding Word}" Width="1.2*"/><DataGridTextColumn Header="音标" Binding="{Binding Phonetic}" Width="1.2*"/><DataGridTextColumn Header="简体中文释义" Binding="{Binding Chinese}" Width="2.5*"/><DataGridTextColumn Header="斩词时间" Binding="{Binding SlashedAt}" Width="1.4*"/></DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="2">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="上一页" Style="{StaticResource Button.Base}" Click="SlashedPrevious_Click"/><Button Content="下一页" Style="{StaticResource Button.Base}" Margin="8,0,0,0" Click="SlashedNext_Click"/><Button Content="取消斩（按计划恢复）" Style="{StaticResource Button.Primary}" Margin="12,0,0,0" Click="RestoreSlashed_Click"/></StackPanel>
                            <StackPanel><TextBlock Text="{Binding SlashedRange}"/><TextBlock Text="{Binding SlashedStatus}" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
                        </DockPanel>
                    </Grid>

                    <!-- 学习统计 -->
                    <ScrollViewer x:Name="StatisticsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="今日复习事件" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ReviewedToday}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="当前完成率" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ProgressRatio, StringFormat={}{0:P0}}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="累计已斩" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SlashedTotal}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                            </Grid>
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="七日学习趋势" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding SevenDayTrend}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Day}"/><ProgressBar Grid.Column="1" Height="9" Maximum="200" Value="{Binding Reviewed, Mode=OneWay}" Margin="12,4"/><TextBlock Grid.Column="2" Text="{Binding Reviewed}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="统计口径" Style="{StaticResource SectionTitle}"/><TextBlock Text="统计读取不可变学习事件；不会用当前设置重算历史评分。随着学习历史积累，这里将逐步显示保持率、困难词与更长期趋势。" Style="{StaticResource Muted}"/></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 设置 -->
                    <TabControl x:Name="SettingsPage" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                        <TabItem Header="学习"><ScrollViewer><StackPanel Margin="4,16"><TextBlock Text="每日任务与调度" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="每日新词"/><TextBox Text="{Binding DailyPlan.NewLimit, UpdateSourceTrigger=LostFocus}" Margin="0,6,14,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="复习软上限"/><TextBox Text="{Binding DailyPlan.SoftReviewLimit, UpdateSourceTrigger=LostFocus}" Margin="0,6,14,0"/></StackPanel><Button Grid.Column="2" Content="保存学习设置" Style="{StaticResource Button.Primary}" Click="SaveDaily_Click" VerticalAlignment="Bottom"/></Grid><TextBlock x:Name="DailyStatus" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border><TextBlock Text="专业调度参数由 FSRS-6 管理。普通设置保持克制，避免误改历史状态。" Style="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="快捷键"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,16"><TextBlock Text="全部快捷键" Style="{StaticResource SectionTitle}"/><TextBlock Text="录制新键位、逐项启用或禁用；冲突时保留原绑定。" Style="{StaticResource Muted}" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Shortcuts.Items}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="160"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Action}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ChordDisplay, Mode=OneWay}" IsReadOnly="True" Tag="{Binding}" PreviewKeyDown="Shortcut_PreviewKeyDown"/><CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" Content="启用" VerticalAlignment="Center"/><Button Grid.Column="3" Content="恢复默认" Tag="{Binding}" Style="{StaticResource Button.Base}" Click="RestoreShortcut_Click"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="悬浮卡与外观"><ScrollViewer><StackPanel Margin="4,16"><TextBlock Text="悬浮卡与皮肤" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PNG 背景" FontWeight="SemiBold"/><TextBlock Text="{Binding Theme.DisplayName}" Style="{StaticResource Muted}" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><Button Content="选择 PNG" Style="{StaticResource Button.Base}" Click="Import_Click"/><Button Content="恢复默认" Style="{StaticResource Button.Base}" Margin="10,0,0,0" Click="Reset_Click"/></StackPanel><TextBlock Text="背景透明度" Margin="0,18,0,5"/><Slider Minimum="0.15" Maximum="1" Value="{Binding Theme.Opacity, UpdateSourceTrigger=PropertyChanged}"/><TextBlock x:Name="ThemeStatus" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="发音"><ScrollViewer><StackPanel Margin="4,16"><TextBlock Text="Windows 本机离线发音" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Pronunciation.Availability.Message}" Style="{StaticResource Muted}"/><CheckBox Content="切换单词后自动朗读" IsChecked="{Binding Pronunciation.Autoplay}" Margin="0,16,0,0"/><TextBlock Text="音量" Margin="0,14,0,4"/><Slider Minimum="0" Maximum="100" Value="{Binding Pronunciation.Volume}"/><TextBlock Text="语速" Margin="0,14,0,4"/><Slider Minimum="-10" Maximum="10" Value="{Binding Pronunciation.Rate}"/><Button Content="保存发音设置" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,18,0,0" Click="SavePronunciation_Click"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="数据与备份"><ScrollViewer><StackPanel Margin="4,16"><TextBlock Text="本地数据" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding OfflineStatus}" FontWeight="SemiBold"/><TextBlock Text="词库与关系库：本地只读数据" Style="{StaticResource Muted}" Margin="0,10,0,0"/><TextBlock Text="学习记录与设置：%LOCALAPPDATA%\WordFlow" Style="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Margin="0,5,0,0" Style="{StaticResource Muted}"><Run Text="版本 "/><Run Text="{Binding Version, Mode=OneWay}"/></TextBlock></StackPanel></Border><TextBlock Text="备份、恢复、导入与导出将在独立的安全事务中执行；普通卸载默认保留个人数据。" Style="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="高级 FSRS"><ScrollViewer><StackPanel Margin="4,16"><TextBlock Text="FSRS-6 高级设置" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="目标保持率与个性化参数" FontWeight="SemiBold"/><TextBlock Text="当前使用经过验证的 FSRS-6 调度器。参数优化只在本机进行，并且不会重写历史学习事件。" Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock Text="为了避免误操作，参数替换需要先生成快照、影响说明和调度预览。" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
