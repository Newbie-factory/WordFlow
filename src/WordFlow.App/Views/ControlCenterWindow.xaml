<Window x:Class="WordFlow.App.Views.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordFlow 控制中心" Width="560" Height="460" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Background="{StaticResource Brush.Canvas}"
        AutomationProperties.Name="WordFlow 控制中心">
    <Border Margin="18" Padding="24" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Effect="{StaticResource Shadow.Card}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource Button.Base}" Click="Close_Click" AutomationProperties.Name="关闭控制中心"/>
                <StackPanel><TextBlock Text="控制中心" FontSize="{StaticResource Type.Title}" FontWeight="SemiBold"/><TextBlock Text="WordFlow · 本地学习空间" Foreground="{StaticResource Brush.InkMuted}" Margin="0,4,0,0"/></StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Margin="0,22,0,14" Padding="16" Background="{StaticResource Brush.AccentSurface}" CornerRadius="{StaticResource Radius.Control}">
                <StackPanel><TextBlock Text="今日进度" FontWeight="SemiBold"/><TextBlock Text="学习卡已准备就绪" FontSize="20" Margin="0,6,0,0"/><TextBlock Text="完成评分后会自动进入下一词；所有数据保存在本机。" Foreground="{StaticResource Brush.InkMuted}" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <StackPanel Grid.Row="2">
                <TextBlock Text="外观与换肤" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,10"/>
                <DockPanel Margin="0,0,0,10"><TextBlock Text="当前背景" VerticalAlignment="Center"/><TextBlock x:Name="ThemeName" DockPanel.Dock="Right" Text="默认浅色背景" Foreground="{StaticResource Brush.InkMuted}" VerticalAlignment="Center"/></DockPanel>
                <StackPanel Orientation="Horizontal"><Button Content="选择 PNG" Style="{StaticResource Button.Base}" Click="Import_Click" AutomationProperties.Name="选择 PNG 背景"/><Button Content="恢复默认" Style="{StaticResource Button.Base}" Margin="10,0,0,0" Click="Reset_Click" AutomationProperties.Name="恢复默认背景"/></StackPanel>
                <TextBlock Text="卡片透明度" Margin="0,18,0,4"/><Slider x:Name="OpacitySlider" Minimum="0.15" Maximum="1" TickFrequency="0.05" AutomationProperties.Name="卡片背景透明度" ValueChanged="Opacity_Changed"/>
                <TextBlock x:Name="Status" Text="" Foreground="{StaticResource Brush.InkMuted}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <TextBlock Grid.Row="3" Text="快捷键、发音与学习行为可在此集中管理。完全离线运行。" Foreground="{StaticResource Brush.InkMuted}" Margin="0,18,0,0"/>
        </Grid>
    </Border>
</Window>
