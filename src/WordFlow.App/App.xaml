<Application x:Class="WordFlow.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WordFlow.App"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- WordFlow visual tokens: restrained neutral canvas + low-saturation blue. -->
        <Color x:Key="Color.Canvas">#F3F6F9</Color>
        <Color x:Key="Color.Surface">#FFFCFA</Color>
        <Color x:Key="Color.SurfaceRaised">#FFFFFF</Color>
        <Color x:Key="Color.Ink">#172235</Color>
        <Color x:Key="Color.InkMuted">#58687A</Color>
        <Color x:Key="Color.Border">#D7E0E8</Color>
        <Color x:Key="Color.ControlBorder">#8496A8</Color>
        <Color x:Key="Color.Accent">#356B96</Color>
        <Color x:Key="Color.AccentStrong">#255577</Color>
        <Color x:Key="Color.AccentSurface">#E7F0F7</Color>
        <Color x:Key="Color.Success">#3F735B</Color>
        <Color x:Key="Color.Error">#A12A32</Color>
        <Color x:Key="Color.ErrorSurface">#FCEDEF</Color>

        <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
        <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
        <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
        <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
        <SolidColorBrush x:Key="Brush.InkMuted" Color="{StaticResource Color.InkMuted}" />
        <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
        <SolidColorBrush x:Key="Brush.ControlBorder" Color="{StaticResource Color.ControlBorder}" />
        <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
        <SolidColorBrush x:Key="Brush.AccentStrong" Color="{StaticResource Color.AccentStrong}" />
        <SolidColorBrush x:Key="Brush.AccentSurface" Color="{StaticResource Color.AccentSurface}" />
        <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
        <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
        <SolidColorBrush x:Key="Brush.ErrorSurface" Color="{StaticResource Color.ErrorSurface}" />

        <FontFamily x:Key="Font.Display">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
        <sys:Double x:Key="Type.Word">38</sys:Double>
        <sys:Double x:Key="Type.Title">18</sys:Double>
        <sys:Double x:Key="Type.Body">14</sys:Double>
        <sys:Double x:Key="Type.Caption">12</sys:Double>
        <sys:Double x:Key="Space.1">4</sys:Double>
        <sys:Double x:Key="Space.2">8</sys:Double>
        <sys:Double x:Key="Space.3">12</sys:Double>
        <sys:Double x:Key="Space.4">16</sys:Double>
        <sys:Double x:Key="Space.5">20</sys:Double>
        <CornerRadius x:Key="Radius.Card">18</CornerRadius>
        <CornerRadius x:Key="Radius.Control">8</CornerRadius>
        <CornerRadius x:Key="Radius.Badge">5</CornerRadius>
        <DropShadowEffect x:Key="Shadow.Card" BlurRadius="24" ShadowDepth="7" Opacity="0.18" Color="#25364A" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />

        <Style x:Key="Focus.Ring">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource Brush.AccentStrong}" BorderThickness="2" CornerRadius="8" Margin="-3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
        </Style>

        <Style x:Key="Button.Base" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.AccentSurface}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.AccentStrong}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.AccentStrong}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.AccentStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBox.Search" TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        </Style>
    </Application.Resources>
</Application>
